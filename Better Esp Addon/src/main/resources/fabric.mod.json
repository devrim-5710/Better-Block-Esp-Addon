{
  "schemaVersion": 1,
  "id": "better-esp",
  "version": "${version}",
  "name": "Better ESP",
  "description": "Enhanced ESP addon for AUTISM Client: entity highlighting, bounding boxes, and tracers.",
  "authors": [
    "theflex5710"
  ],
  "custom": {
    "autism:color": "0,200,255",
    "modmenu": {
      "parent": {
        "id": "autism"
      }
    }
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.betteresp.BetterEspInit"
    ],
    "autism": [
      "com.betteresp.BetterEspAddon"
    ]
  },

  "depends": {
    "java": ">=25",
    "minecraft": "${mc_compat}",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=${fabric_api_version}",
    "autism": ">=${autism_api_version}"
  }
}
