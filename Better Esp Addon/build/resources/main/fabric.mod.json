{
  "schemaVersion": 1,
  "id": "better-esp",
  "version": "1.0.0",
  "name": "Better ESP",
  "description": "Enhanced ESP addon for AUTISM Client: entity highlighting, bounding boxes, and tracers.",
  "authors": [
    "theflex5710"
  ],
  "custom": {
    "autism:color": "0,200,255",
    "modmenu": {
      "parent": {
        "id": "autism"
      }
    }
  },
  "environment": "client",
  "entrypoints": {
