{
  "schemaVersion": 1,
  "id": "better-block-esp",
  "version": "${version}",
  "name": "Better Block Esp Addon",
  "description": "Per block colors for AUTISM Client's BlockESP module. No extra module, just new settings.",
  "authors": [
    "theflex5710"
  ],
  "contact": {
    "author": "theflex5710"
  },
  "custom": {
    "autism:color": "255,170,0",
    "modmenu": {
      "parent": {
        "id": "autism"
      }
    }
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.betterblockesp.BetterBlockEspInit"
    ],
    "autism": [
      "com.betterblockesp.BetterBlockEspAddon"
    ]
  },
  "mixins": [
    "better-block-esp.mixins.json"
  ],
  "depends": {
    "java": ">=25",
    "minecraft": "${mc_compat}",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=${fabric_api_version}",
    "autism": ">=${autism_api_version}"
  }
}
